<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compila el Núcleo fuera de Unity con la misma superficie de API (.NET Standard 2.1) y la misma
    versión de C# que Unity, para que la integración continua no necesite licencia de Unity.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>FgcTag.Nucleo</AssemblyName>
    <RootNamespace>FgcTag.Nucleo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/_Proyecto/Codigo/Nucleo/**/*.cs" />
  </ItemGroup>

</Project>
